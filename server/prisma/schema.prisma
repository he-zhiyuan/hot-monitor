generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 关键词监控任务
model Monitor {
  id          String    @id @default(cuid())
  keyword     String
  description String?
  isActive    Boolean   @default(true)
  intervalMin Int       @default(15)
  /// Query expansion（JSON）：phrases + modelNotes，用于本地预筛与 AI 提示
  queryExpansion String?
  /// 低于此相关度(0-1)不推送通知；默认 0.65
  minRelevance   Float   @default(0.65)
  lastChecked DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  findings    Finding[]
}

// 监控发现的内容
model Finding {
  id          String   @id @default(cuid())
  monitorId   String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  title       String
  content     String
  url         String
  source      String
  author      String?
  publishedAt DateTime?
  likes       Int?
  comments    Int?
  shares      Int?
  views       Int?
  aiScore     Float    @default(0)
  aiSummary   String   @default("")
  /// 判定理由 / 证据说明（与摘要分离）
  aiReason    String   @default("")
  isNotified  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// 热点发现条目
model HotSpot {
  id          String   @id @default(cuid())
  title       String
  summary     String
  url         String
  source      String
  author      String?
  domain      String
  heatScore   Float    @default(0)
  sourceCount Int      @default(1)
  isRead      Boolean  @default(false)
  isSaved     Boolean  @default(false)
  likes       Int?
  comments    Int?
  shares      Int?
  views       Int?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
}

// 通知记录
model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  type      String   @default("monitor")
  refId     String?
  url       String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// 系统配置（KV 存储）
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
