# 数据库
DATABASE_URL="file:./prisma/dev.db"

# AI 服务 (https://openrouter.ai)
OPENROUTER_API_KEY="sk-or-your-key-here"
# 免费模型（默认）：google/gemma-4-31b-it:free
# 付费模型（效果更好，需充值）：google/gemini-2.5-flash
# OPENROUTER_MODEL="google/gemini-2.5-flash"

# Twitter (https://twitterapi.io)
TWITTERAPI_IO_KEY="your-twitterapi-io-key"

# 邮件通知（SMTP）
SMTP_HOST="smtp.qq.com"
SMTP_PORT="587"
SMTP_USER="你的QQ号@qq.com"
SMTP_PASS="你的授权码"          # 注意：不是QQ密码，是授权码
NOTIFY_EMAIL_TO="你的QQ号@qq.com"

# 服务端口
PORT=3001

# 前端地址（用于 CORS）
CLIENT_URL="http://localhost:5173"
