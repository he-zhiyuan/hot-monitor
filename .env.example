# 数据库
DATABASE_URL="file:./prisma/dev.db"

# EasyRouter AI（推荐，https://easyrouter.io，OpenAI 兼容格式，国内稳定可用）
EASYROUTER_API_KEY="sk-your-easyrouter-key-here"
# 可选：指定模型（默认 gemini-2.5-flash）
# EASYROUTER_MODEL="gpt-4o-mini"

# OpenRouter（备用，https://openrouter.ai）
OPENROUTER_API_KEY="sk-or-your-key-here"

# Twitter (https://twitterapi.io)
TWITTERAPI_IO_KEY="your-twitterapi-io-key"

# 邮件通知（SMTP）
SMTP_HOST="smtp.qq.com"
SMTP_PORT="587"
SMTP_USER="你的QQ号@qq.com"
SMTP_PASS="你的授权码"          # 注意：不是QQ密码，是授权码
NOTIFY_EMAIL_TO="你的QQ号@qq.com"

# 服务端口
PORT=3001

# 全局默认：低于该相关度(0-1)不推送（单条监控可在 DB 覆盖 minRelevance）
# MONITOR_MIN_RELEVANCE=0.65

# 前端地址（用于 CORS）
CLIENT_URL="http://localhost:5173"

